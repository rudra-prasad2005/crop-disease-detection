   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. (Optional) Run on a sample image from the dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import random, pathlib\n",
    "valid_dir = pathlib.Path(LOCAL_PROJECT_DIR) / 'data' / 'splits' / 'valid'\n",
    "all_imgs = list(valid_dir.rglob('*.JPG'))\n",
    "sample = random.choice(all_imgs)\n",
    "print('Predicting on:', sample)\n",
    "\n",
    "!python main.py predict \"{sample}\" --top-k 5"
   ]
  }
